              "kind": {
                "const": "take"
              },
              "player_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              }
            },
            "required": [
              "action_id",
              "kind",
              "player_id"
