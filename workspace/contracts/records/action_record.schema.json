{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "decision_id": {
      "type": "string",
      "maxLength": 256
    },
    "observation_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "applied_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "observation_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "raw_response": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 65536
        },
        {
          "type": "null"
        }
      ]
    },
    "parse_error": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 65536
        },
        {
          "type": "null"
        }
      ]
    },
    "fault": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "object",
              "properties": {
                "source": {
                  "enum": [
                    "engine",
                    "host"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "required": [
                "source",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "fallback": {
      "type": "null"
    },
    "team_id": {
      "enum": [
        "away",
        "home"
      ]
    },
    "requested_actions": {},
    "accepted_intents": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "kind": {
                "const": "pitch"
              },
              "player_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "direction_i32": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              },
              "power_u16": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            },
            "required": [
              "action_id",
              "kind",
              "player_id",
              "direction_i32",
              "power_u16"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "kind": {
                "const": "throw"
              },
              "player_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "direction_i32": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              },
              "power_u16": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            },
            "required": [
              "action_id",
              "kind",
              "player_id",
              "direction_i32",
              "power_u16"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "kind": {
                "const": "swing"
              },
              "player_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
