  "required": [
    "seq",
    "decision_id",
    "observation_tick",
    "applied_tick",
    "observation_hash",
    "raw_response",
    "parse_error",
    "fault",
    "fallback",
    "team_id",
    "requested_actions",
    "accepted_intents",
