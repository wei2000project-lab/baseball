              "player_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "target_q": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
