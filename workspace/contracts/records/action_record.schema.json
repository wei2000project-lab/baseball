              "player_id",
              "target_base"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "kind": {
                "const": "tag"
              },
              "player_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "runner_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              }
            },
            "required": [
              "action_id",
              "kind",
              "player_id",
              "runner_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "kind": {
                "const": "appeal_return"
              },
              "player_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "runner_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              }
            },
            "required": [
              "action_id",
              "kind",
              "player_id",
              "runner_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action_id": {
                "type": "string",
                "pattern": "[A-Za-z0-9_.:-]+",
                "maxLength": 128
              },
              "kind": {
                "const": "noop"
              }
            },
            "required": [
              "action_id",
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 9
    },
    "validation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "clamped",
              "rejected"
            ]
          },
          "action_id": {},
          "reason": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    }
